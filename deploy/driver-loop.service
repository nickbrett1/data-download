[Unit]
Description=data-download driver loop (builds a missing driver on request)
Documentation=https://github.com/nickbrett1/data-download/blob/main/deploy/README.md
# The loop reads the store and writes the drivers volume; it needs GitHub and
# the vendor runtime, so it waits for the network and for Docker (the drivers
# runtime is a container, and the probe is an HTTP call to it).
After=network-online.target docker.service
Wants=network-online.target
# Not `Requires=`: an app restart must not silently stop driver building. Every
# state is durable in the store, so a restart resumes from the queue.
RequiresMountsFor=/srv/appdata/data-download /srv/appdata/data-download-drivers

[Service]
Type=simple
User=nick
Group=nick
# Everything the loop needs: the store, the datasets root, the drivers volume,
# the runtime URL and token, the GitHub token, and the authoring harness. All of
# it is config, so the unit carries no paths of its own beyond the supervisor.
EnvironmentFile=/srv/appdata/data-download-drivers/loop.env
WorkingDirectory=/srv/appdata/data-download-drivers
# The SUPERVISOR, not `driver_build --once`: the loop is run-to-exit by design,
# so a unit that execs it once would look up and never poll. With `Restart=
# on-failure` alone a clean exit would also never restart -- the supervisor is
# the thing that never exits, and it owns the poll interval and the backoff for
# a misconfigured host.
ExecStart=/bin/sh /srv/appdata/data-download-drivers/loop/scripts/driver-loop.sh
# A stop is a signal, not a kill: the longest step is an authoring run behind a
# 3600 s timeout. Nothing is corrupted by a stop -- a job interrupted mid-install
# leaves a staging directory inside the drivers volume that the next pass
# removes -- so a generous grace is cheaper than an impatient kill.
TimeoutStopSec=120
Restart=on-failure
RestartSec=60

# -- sandbox ----------------------------------------------------------------
# ProtectSystem=strict makes the whole filesystem read-only except what is
# named below, which is the point: an authored artefact installs into the
# drivers volume and can write nowhere else, even if the code it wrote tried.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/appdata/data-download /srv/appdata/data-download-drivers
# The authoring harness is a real program in the operator's home (goose lives in
# ~/.local/bin and keeps provider state under ~/.config/goose), so the home
# directory is readable and the two paths an agent legitimately writes are
# reopened. The `-` prefix means "ignore if it does not exist" -- a host that
# runs a different agent must not fail to start because goose's directories are
# absent.
ProtectHome=read-only
ReadWritePaths=-/home/nick/.config/goose -/home/nick/.local/state -/home/nick/.cache

[Install]
WantedBy=multi-user.target
