# Environment variables for data-download (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

# SQLite file for the request book. Required in a real deployment: when unset
# the service falls back to an in-memory store and warns loudly, because the
# generated `docker_smoke` step runs the image with no environment at all.
DATA_DOWNLOAD_DB=

# Bearer tokens and their scopes. Accepted forms:
#   token:submit+read                      (delimiter-separated; the deployment
#                                           holds exactly one, held by the agent)
#   token:submit;token2:read               (add a second entry only if a reader
#                                           must not be able to submit)
#   {"token": ["submit","read"], ...}      (JSON)
#   a bare token                           (means submit+read)
#
# Scopes are enforced server-side, and they guard `/v1/*` -- the API the agent
# uses. The UI is not behind them: it is a public read-only projection (see the
# main README, "What is public, and what is not"). Do not mint a `read` token
# for a browser, and never put one in a URL or a Homepage `href`.
#
# `approve` is retired. It is still accepted here so an older file starts, and
# it gates nothing: approval is authorised by tailnet identity, below.
DATA_DOWNLOAD_API_TOKENS=

# The MCP surface: `/mcp` exposes the same doors as tools, for an agent that has
# no browser -- file a request, read the book, price one, see what has landed.
# The value is the token those tools send, and it MUST be one of the tokens in
# DATA_DOWNLOAD_API_TOKENS: the surface authenticates through `/v1` like any
# other caller, so it can only do what that token's scopes allow. A token not in
# the list grants nothing and is refused at boot, with a log line saying so.
#
# Unset means no `/mcp` is mounted at all -- the pages and `/v1` are untouched.
# Nothing about this setting can approve, run, or cancel anything: approval is
# the tailnet identity above, and no header a tool can send produces one.
#
#   DATA_DOWNLOAD_MCP_TOKEN=<the submit+read token from the list above>
DATA_DOWNLOAD_MCP_TOKEN=

# Which tailnet logins may approve a request, and therefore spend money.
# Comma- or space-separated, matched case-insensitively, e.g.
#
#   DATA_DOWNLOAD_APPROVERS=you@example.com
#
# The login comes from `Tailscale-User-Login`, which `tailscale serve` adds for
# the peer it authenticated -- and the app believes it only from a loopback
# peer, so Serve must be the thing in front of this container. Unset means
# nobody may approve: the door fails closed rather than treating "has a
# tailnet" as "may spend". See deploy/README.md §6.
DATA_DOWNLOAD_APPROVERS=

# Which peer address is allowed to assert that identity. Unset trusts loopback
# only, which is correct when the app runs directly on the host.
#
# In a container it is not loopback: Docker's port forward re-originates the
# connection, so `tailscale serve` on the host reaches this process from the
# bridge gateway (172.x.0.1). The refusal names the address it saw; put that
# here. Only add an address nothing else can originate from -- binding the
# published port to 127.0.0.1 is what makes that true.
#
#   DATA_DOWNLOAD_TRUSTED_PROXIES=172.17.0.1
DATA_DOWNLOAD_TRUSTED_PROXIES=

# The Databento API key. Phase 4: a request is priced at submit by asking the
# vendor what its Job's `quote` step would cost, and the price is compared
# against the requester's ceiling. This key is the only credential-bearing
# client in the service, and it is imported in exactly one module (`vendor.py`)
# so the whole surface can be audited in one file.
#
# Unset means nothing can be priced, so every submit is refused with
# `quote_unavailable`: an unpriced request is one whose approval authorises an
# unknown amount. Reads, the dashboard, approval and the store all keep working.
#
#   DATA_DOWNLOAD_DATABENTO_KEY=db-...
DATA_DOWNLOAD_DATABENTO_KEY=

# Phase 5: where a runner puts bytes. Inside the container this is always
# /datasets; the host directory it is bound to is configured separately, below.
# Unset means the runner refuses to run anything rather than guessing a path.
DATA_DOWNLOAD_DATASETS_DIR=/datasets

# The host directory mounted at /datasets. One folder per requested dataset,
# one folder per request underneath. Defaults to /srv/datasets (the shared
# datasets mount on ryzen); a Synology would use a /volume1 share instead.
DATA_DOWNLOAD_DATASETS_HOST_DIR=
