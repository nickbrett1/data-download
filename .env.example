# Environment variables for data-download (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

# SQLite file for the request book. Required in a real deployment: when unset
# the service falls back to an in-memory store and warns loudly, because the
# generated `docker_smoke` step runs the image with no environment at all.
DATA_DOWNLOAD_DB=

# Bearer tokens and their scopes. Accepted forms:
#   token:submit+read;token2:read          (delimiter-separated, what the host uses)
#   {"token": ["submit","read"], ...}      (JSON, when you need `approve` named)
#   a bare token                           (means submit+read; never approve)
#
# Scopes are enforced server-side. `approve` is deliberately not reachable over
# HTTP at all in phase 1 - approval is a CLI verb - so no token should need it.
DATA_DOWNLOAD_API_TOKENS=
