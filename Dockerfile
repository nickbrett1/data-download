# Multi-stage image for data-download
# Generated by genproj (docker-container capability, language-aware). Adjust
# for your application.
#
# Stage 1 (web): builds the Svelte frontend to static files. Nothing from this
# stage survives except `dist`, and the image itself is still python -- the
# frontend compiles here and FastAPI serves the result, so there is no node
# process (and no node) at runtime.
#
# Stage 2 (build): copies the full source tree, installs dependencies and
# builds the application -- with the frontend's output already in the package,
# because it ships as package data (`web/index.html`, `web/assets/*`).
# Stage 3 (runtime): copies only the virtualenv and the source, keeping the
# final image small.

FROM node:24-slim AS web
WORKDIR /web
# The lockfile first, so a dependency change is the only thing that misses the
# layer cache.
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS build
WORKDIR /app
COPY . .
COPY --from=web /web/dist src/data_download/web
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && if [ -f requirements.txt ]; then \
         grep -vE '^\s*(-e|--editable)\s+\.' requirements.txt > /tmp/reqs.txt || true; \
         [ -s /tmp/reqs.txt ] && /opt/venv/bin/pip install --no-cache-dir -r /tmp/reqs.txt; \
       fi \
    && if [ -f pyproject.toml ]; then \
         /opt/venv/bin/pip install --no-cache-dir .; \
       fi

FROM python:3.12-slim
WORKDIR /app
# The commit this image was built from (§4.1's `code_ref`). An image has no
# `.git`, so this is the only way the deployment can say which code is running;
# unset means the store records NULL and a claim refuses it, which is honest
# rather than guessing. The pipeline does not pass it yet (genproj owns
# `.buildkite/pipeline.yml`) -- wire `--build-arg GIT_SHA=$BUILDKITE_COMMIT`
# when it can.
ARG GIT_SHA
ENV DATA_DOWNLOAD_CODE_REF=${GIT_SHA}
# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/data-download so it inherits the
# repo's access (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/data-download
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=build /opt/venv /opt/venv
COPY . .
EXPOSE 8820

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s CMD curl -fsS http://127.0.0.1:8820/healthz || exit 1
CMD ["python","-m","data_download","--host","0.0.0.0","--port","8820"]
